{
  "schema_version": 1,
  "repositories": [
    {
      "target_repo": "WenjieZhao1/fixflow",
      "display_name": "Fixflow",
      "checkout_dir": "fixflow",
      "prompt_note": "Use the Fixflow source tree, docs, and current main branch.",
      "apply_close_rules": {
        "issue": [
          "implemented_on_main",
          "mostly_implemented_on_main",
          "cannot_reproduce",
          "duplicate_or_superseded",
          "not_actionable_in_repo",
          "incoherent",
          "stale_insufficient_info"
        ],
        "pull_request": [
          "implemented_on_main",
          "mostly_implemented_on_main",
          "cannot_reproduce",
          "duplicate_or_superseded",
          "not_actionable_in_repo",
          "incoherent"
        ]
      }
    }
  ]
}
